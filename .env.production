# 生产环境：API 走同源（Netlify 将 /api/* 反代到 Worker，见 netlify.toml）。
# 留空使用 src/lib/api-base.ts 的生产回退 window.location.origin，勿填跨域绝对地址
# （跨注册域 Cookie 会被现代浏览器分区/拦截，OAuth state 与会话都会失效）。
VITE_API_BASE_URL=

# 站内通知 WS 直连 Worker 域：Netlify 反代会剥离 `Upgrade` 头，同源 WS 建不起来
# （实测握手到 DO 变成 404）。用一次性 ticket 鉴权，跨站建连不依赖 Cookie 属性。
VITE_WS_BASE_URL=https://luminolcraft-nexus.narcssu.top
